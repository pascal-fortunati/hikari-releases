{
  "name": "hikari-official-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 43123",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:dev": "node scripts/verify-development.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "format": "prettier --write src tests scripts deploy next.config.ts postcss.config.mjs playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "@tailwindcss/postcss": "4.3.3",
    "flyonui": "2.4.1",
    "material-icons": "^1.13.14",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
